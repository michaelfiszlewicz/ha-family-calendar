# =============================================================================
# wyze-bridge.env.example
# =============================================================================
# 1. Copy this file to `wyze-bridge.env`  (same folder as docker-compose-wyze.yml)
# 2. Fill in the values below.
# 3. NEVER commit wyze-bridge.env to git — it holds your Wyze login + API keys.
#
# HOW TO GET THE API KEY / KEY ID (STRONGLY recommended — required for 2FA):
#   * Log in at https://developer-api-console.wyze.com/#/apikey/view
#   * Create an API Key. You'll get an "API Key" and a "Key Id".
#   * Use the SAME email as your Wyze app account below.
#
# NOTE: The API Key/ID is used for LOGIN ONLY — Wyze has no live-video API.
#       With the API key set, the bridge no longer needs your password, though
#       leaving WYZE_PASSWORD set is fine as a fallback.
# =============================================================================

# ---- Wyze account (TODO: fill in email; password optional if API key set) ----
WYZE_EMAIL=you@example.com
WYZE_PASSWORD=your-wyze-password

# ---- Wyze developer API auth (TODO: fill in — recommended) ----
API_ID=your-wyze-key-id
API_KEY=your-wyze-api-key

# ---- Optional web UI protection (recommended) ----
# Sets the username/password for the bridge web UI at http://<host>:5000
WB_USERNAME=admin
WB_PASSWORD=change-me

# ---- Optional: restrict which cameras are published ----
# Comma-separated list of camera nicknames exactly as they appear in the app.
# FILTER_NAMES=Backyard, Garage, Side Gate
